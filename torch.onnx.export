import torch
import torch.nn as nn

class SentinelCorePyTorch(nn.Module):
    def __init__(self):
        super().__init__()
        # Example lightweight feature extractor / linear classifier
        self.encoder = nn.Sequential(
            nn.Linear(128, 256),
            nn.ReLU(),
            nn.Linear(256, 128)
        )

    def forward(self, input_ids):
        return self.encoder(input_ids)

def export_pytorch_to_onnx(output_path):
    model = SentinelCorePyTorch()
    model.eval()

    dummy_input = torch.randn(1, 128, dtype=torch.float32)

    torch.onnx.export(
        model,
        dummy_input,
        output_path,
        export_params=True,
        opset_version=17,
        do_constant_folding=True,
        input_names=['input_ids'],
        output_names=['output'],
        dynamic_axes={
            'input_ids': {0: 'batch_size'},
            'output': {0: 'batch_size'}
        }
    )
    print(f"[SUCCESS] PyTorch model exported to ONNX at: {output_path}")
